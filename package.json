{
  "name": "pay-per-task-agent",
  "version": "0.1.0",
  "description": "An AI agent paid per finished task in Bitcoin Cash, with a human approval gate and an append-only audit log.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npm run build && node src/server.js",
    "test": "node --test test/*.test.js",
    "build": "esbuild web/wallet.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=public/wallet.bundle.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bitauth/libauth": "^3.0.0",
    "@electrum-cash/network": "^4.4.8",
    "@wizardconnect/dapp": "^0.2.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
